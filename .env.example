EXPO_PUBLIC_SUPABASE_URL=your_supabase_url
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# TrueLayer Data API credentials (set as edge function secrets)
TRUELAYER_CLIENT_ID=your_truelayer_client_id
TRUELAYER_CLIENT_SECRET=your_truelayer_client_secret
# Either "sandbox" or "live" (defaults to sandbox)
TRUELAYER_ENV=sandbox
RESEND_API_KEY=your_resend_api_key
EXPO_PUBLIC_LOGO_DEV_API_KEY=your_logo_dev_key
SENTRY_DSN=your_sentry_dsn
EXPO_PUBLIC_POSTHOG_KEY=your_posthog_key
